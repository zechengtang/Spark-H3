+    route_bits = torch.empty((batch, heads, ntb, words), dtype=torch.int32, device=q.device)
+    anchor = torch.empty((batch, heads, dim), dtype=anchor_dtype, device=q.device)
+    ak = torch.empty((batch, heads, ntb, dim), dtype=torch.bfloat16, device=q.device)
+    av = torch.empty_like(ak)
+    lm = torch.empty((batch, heads, ntb), dtype=torch.float32, device=q.device)
+    rtp = ((ntb + 63) // 64) * 64
