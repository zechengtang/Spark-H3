+        raise ValueError("spark_attn: anchor_dtype must be torch.float32 or torch.bfloat16")
+    if tail_granularity not in ("block", "query"):
+        raise ValueError("spark_attn: tail_granularity must be 'block' or 'query'")
+    if type(reweight) is not bool:
+        raise TypeError("spark_attn: reweight must be bool")
+    if topk_ratio < 0 or topk_ratio > 1:
+        raise ValueError("spark_attn: topk_ratio must lie in [0, 1]")
+    # Spark exposes 1.0 as the useful all-exact endpoint.  Stock Sol reserves
+    # topk_ratio=0 for tau routing, so express that endpoint as tau=-infinity.
+    all_exact = topk_ratio == 1.0
