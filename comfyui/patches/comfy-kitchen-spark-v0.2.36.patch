index 0000000..ba961be
--- /dev/null
+++ b/comfy_kitchen/backends/cuda/sage_attention/spark_block_tail.cu
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: Apache-2.0
+// KV reweight summaries are independent of query granularity. This consumer
+// evaluates one centroid per query block, then hands shared o/m/l to Sol exact.
+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+#include "sol_layout.cuh"
+
+namespace {
+using namespace sol;
+constexpr int HD = HEAD_DIM, BK = BLOCK, THREADS = 128;
+constexpr int KC = TILE_KC, NT = TILE_NT, NKT = TILE_NKT;
+constexpr int LDK = TILE_LDK, LDV = TILE_LDV;
+
+__global__ void spark_block_tail_kernel(
+    const int8_t* cen, const float* cs, const int8_t* ki,
+    const float2* ks, const int8_t* vt, const uint32_t* bits,
+    __nv_bfloat16* out, float* om, float* ol,
+    int nq, int nk, int storage, float scale_log2)
+{
+#if SOL_SM80
+    __shared__ __align__(16) int8_t sk[2 * BK * LDK];
+    __shared__ __align__(16) int8_t sv[2 * HD * LDV];
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    const int g = lane >> 2, qd = lane & 3, bh = blockIdx.y;
+    const int rows[2] = {int(blockIdx.x) * 64 + warp * 16 + g,
+                         int(blockIdx.x) * 64 + warp * 16 + g + 8};
+    uint32_t qa[KC][4];
+    float qsc[2];
+    for (int r = 0; r < 2; ++r) {
+        const int qr = min(rows[r], nq - 1);
+        const int8_t* p = cen + ((int64_t)bh * nq + qr) * HD;
+        qsc[r] = cs[(int64_t)bh * nq + qr] * scale_log2;
+        #pragma unroll
+        for (int kc = 0; kc < KC; ++kc) {
+            const uint2 a = *reinterpret_cast<const uint2*>(p + kc * 32 + qd * 8);
+            qa[kc][r] = a.x;
+            qa[kc][r + 2] = a.y;
+        }
+    }
+    float acc[NT][4] = {};
+    float m[2] = {NEG, NEG}, l[2] = {}, c[2] = {NEG, NEG};
+    const int words = (nk + 31) / 32, groups = (nk + BK - 1) / BK;
+    auto stage = [&](int gb, int buf) {
+        for (int i = tid; i < BK * (HD / 16); i += THREADS) {
+            const int p = i / (HD / 16), d = i % (HD / 16);
+            cp_async16(sk + buf * BK * LDK + p * LDK + ((d ^ swz_k(p)) << 4),
+                       ki + ((int64_t)bh * storage + gb * BK + p) * HD + d * 16);
+        }
+        for (int i = tid; i < HD * 4; i += THREADS) {
+            const int d = i >> 2, p = i & 3;
+            cp_async16(sv + buf * HD * LDV + d * LDV + ((p ^ swz_v(d)) << 4),
+                       vt + ((int64_t)bh * HD + d) * storage + gb * BK + p * 16);
+        }
+    };
+    stage(0, 0);
+    cp_commit();
+    for (int gb = 0; gb < groups; ++gb) {
+        const int buf = gb & 1;
+        if (gb + 1 < groups) stage(gb + 1, (gb + 1) & 1);
+        cp_commit();
+        cp_wait<1>();
+        __syncthreads();
+        uint32_t mask[2][2];
+        #pragma unroll
+        for (int r = 0; r < 2; ++r) {
+            for (int w = 0; w < 2; ++w) {
+                uint32_t b = 0;
+                if (qd == 0 && rows[r] < nq && gb * 2 + w < words)
+                    b = bits[((int64_t)bh * nq + rows[r]) * words + gb * 2 + w];
+                mask[r][w] = __shfl_sync(0xffffffffu, b, 0, 4);
+            }
+        }
+        int32_t scores[NKT][4];
+        tile_qk(sk + buf * BK * LDK, qa, g, qd, scores);
+        float prob[NKT][4], bmax[2] = {m[0] - 20.f, m[1] - 20.f};
+        bool has[2] = {};
+        #pragma unroll
+        for (int nt = 0; nt < NKT; ++nt) {
+            const int slot = nt * 8 + qd * 2;
+            const float4 sb = *reinterpret_cast<const float4*>(
+                ks + (int64_t)bh * storage + gb * BK + slot);
+            #pragma unroll
+            for (int e = 0; e < 4; ++e) {
+                const int r = e >> 1, j = e & 1;
+                const int logical = perm_key(slot + j);
+                const bool live = gb * BK + logical < nk &&
+                    (mask[r][logical >> 5] & (1u << (logical & 31)));
+                const float s = live ? fmaf(float(scores[nt][e]),
+                    qsc[r] * (j ? sb.z : sb.x), j ? sb.w : sb.y) : NEG;
+                prob[nt][e] = s;
+                if (s > TILE_MASKED) { has[r] = true; bmax[r] = fmaxf(bmax[r], s); }
+            }
+        }
+        tile_softmax_pv<true>(prob, bmax, has, sv + buf * HD * LDV,
+                             g, qd, m, l, c, acc);
+        __syncthreads();
+    }
+    cp_wait<0>();
+    for (int r = 0; r < 2; ++r) if (rows[r] < nq) {
+        const int64_t row = (int64_t)bh * nq + rows[r];
+        #pragma unroll
+        for (int nt = 0; nt < NT; ++nt) {
+            const int d = nt * 8 + qd * 2;
+            out[row * HD + d] = __float2bfloat16(acc[nt][r * 2]);
+            out[row * HD + d + 1] = __float2bfloat16(acc[nt][r * 2 + 1]);
+        }
+        if (qd == 0) { om[row] = c[r]; ol[row] = l[r]; }
+    }
+#endif
+}
+}
+
+void launch_spark_block_tail(const void* cen, const void* cs, const void* ki,
+    const void* ks, const void* vt, const void* bits,
+    void* out, void* om, void* ol, int bh, int nq, int nk, int storage,
+    float scale_log2, cudaStream_t stream)
+{
+    spark_block_tail_kernel<<<dim3((nq + 63) / 64, bh), THREADS, 0, stream>>>(
+        (const int8_t*)cen, (const float*)cs, (const int8_t*)ki,
+        (const float2*)ks, (const int8_t*)vt, (const uint32_t*)bits,
+        (__nv_bfloat16*)out, (float*)om, (float*)ol, nq, nk, storage, scale_log2);
+}
diff --git a/comfy_kitchen/backends/cuda/sage_attention/spark_reblock.cu b/comfy_kitchen/backends/cuda/sage_attention/spark_reblock.cu
new file mode 100644
index 0000000..d4fadea
--- /dev/null
+++ b/comfy_kitchen/backends/cuda/sage_attention/spark_reblock.cu
@@ -0,0 +1,84 @@
+/*
+ * SPDX-FileCopyrightText: Copyright (c) 2025 Comfy Org. All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Head-wise token gathers used by Spark-H3 reblocking.  The permutation is
+ * destination-to-source: out[b, t, h] = in[b, permutation[b, h, t], h].
+ * Context rows after video_tokens retain their packed order.
+ */
+
+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+
+namespace {
+
+constexpr int VEC_BYTES = 16;
+
+template <typename E, typename I>
+__global__ void spark_reblock_bthd_kernel(
+    const E* __restrict__ input, const I* __restrict__ permutation,
+    E* __restrict__ output, int T, int H, int D, int video_tokens, int rows)
+{
+    const int vecs_per_row = D * (int)sizeof(E) / VEC_BYTES;
+    const int64_t linear = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;
+    const int64_t total = (int64_t)rows * vecs_per_row;
+    if (linear >= total) return;
+    const int row = (int)(linear / vecs_per_row);
+    const int vec = (int)(linear - (int64_t)row * vecs_per_row);
+    const int b = row / (T * H);
+    const int rem = row - b * T * H;
+    const int t = rem / H;
+    const int h = rem - t * H;
+    int src_t = t;
+    if (t < video_tokens)
+        src_t = (int)permutation[((int64_t)b * H + h) * video_tokens + t];
+
+    const int elems_per_vec = VEC_BYTES / (int)sizeof(E);
+    const int d = vec * elems_per_vec;
+    const int64_t src = (((int64_t)b * T + src_t) * H + h) * D + d;
+    const int64_t dst = (((int64_t)b * T + t) * H + h) * D + d;
+    *reinterpret_cast<uint4*>(output + dst) =
+        *reinterpret_cast<const uint4*>(input + src);
+}
+
+template <typename E, typename I>
+void launch_typed(const void* input, const void* permutation, void* output,
+                  int B, int T, int H, int D, int video_tokens,
+                  cudaStream_t stream)
+{
+    constexpr int THREADS = 128;
+    const int vecs = D * (int)sizeof(E) / VEC_BYTES;
+    const int rows = B * T * H;
+    dim3 grid((int)(((int64_t)rows * vecs + THREADS - 1) / THREADS));
+    spark_reblock_bthd_kernel<E, I><<<grid, THREADS, 0, stream>>>(
+        (const E*)input, (const I*)permutation, (E*)output,
+        T, H, D, video_tokens, rows);
+}
+
+}  // namespace
+
+extern "C" void launch_spark_reblock_bthd(
+    const void* input, const void* permutation, void* output,
+    int B, int T, int H, int D, int elem, int index64, int video_tokens,
+    cudaStream_t stream)
+{
+    if (D <= 0 || ((int64_t)D * 2) % VEC_BYTES)
+        throw std::runtime_error("spark_reblock_bthd: D*sizeof(element) must be 16-byte aligned");
+    if (video_tokens < 0 || video_tokens > T)
+        throw std::runtime_error("spark_reblock_bthd: video_tokens must lie in [0, T]");
+    if (elem == 1) {
+        if (index64) launch_typed<__half, int64_t>(input, permutation, output, B, T, H, D, video_tokens, stream);
+        else launch_typed<__half, int32_t>(input, permutation, output, B, T, H, D, video_tokens, stream);
+    } else {
+        if (index64) launch_typed<__nv_bfloat16, int64_t>(input, permutation, output, B, T, H, D, video_tokens, stream);
+        else launch_typed<__nv_bfloat16, int32_t>(input, permutation, output, B, T, H, D, video_tokens, stream);
+    }
+    const cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess)
+        throw std::runtime_error(std::string("spark_reblock_bthd: kernel launch failed: ") +
+                                 cudaGetErrorString(err));
+}
diff --git a/comfy_kitchen/backends/cuda/sage_attention/spark_reweight.cu b/comfy_kitchen/backends/cuda/sage_attention/spark_reweight.cu
new file mode 100644
index 0000000..1dc657d
--- /dev/null
+++ b/comfy_kitchen/backends/cuda/sage_attention/spark_reweight.cu
@@ -0,0 +1,420 @@
+/*
+ * SPDX-FileCopyrightText: Copyright (c) 2025 Comfy Org. All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Spark-H3's global virtual-query reweighting.  Each key block is summarized
+ * around the mean target-video query (AK, AV, log-mass).  Unrouted blocks are
+ * then accumulated for every real query row into the same online-softmax
+ * carrier consumed by Sol's exact INT8 kernel.
+ */
+
+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+
+#include "sol_layout.cuh"
+
+namespace {
+using namespace sol;
+constexpr int HD = HEAD_DIM, BLK = BLOCK;
+
+__device__ __forceinline__ float anchor_to_f32(float x) { return x; }
+__device__ __forceinline__ float anchor_to_f32(__nv_bfloat16 x) {
+    return __bfloat162float(x);
+}
+__device__ __forceinline__ void store_anchor(float* out, float x) { *out = x; }
+__device__ __forceinline__ void store_anchor(__nv_bfloat16* out, float x) {
+    *out = __float2bfloat16(x);
+}
+
+__device__ __forceinline__ int source_token(
+    int t, const void* __restrict__ permutation, int index64,
+    int video_tokens, int bh) {
+    if (!permutation || t >= video_tokens) return t;
+    const int64_t off = (int64_t)bh * video_tokens + t;
+    return index64 ? (int)((const int64_t*)permutation)[off]
+                   : ((const int32_t*)permutation)[off];
+}
+
+template <typename A>
+__global__ void spark_anchor_from_blocks_kernel(
+    const float* __restrict__ qmean, A* __restrict__ anchor,
+    int video_tokens, int NPAD) {
+    const int bh = blockIdx.x, d = threadIdx.x;
+    float sum = 0.f;
+    const int blocks = (video_tokens + BLK - 1) / BLK;
+    for (int qb = 0; qb < blocks; ++qb) {
+        const int len = min(BLK, video_tokens - qb * BLK);
+        sum = fmaf(qmean[((int64_t)bh * NPAD + qb) * HD + d], (float)len, sum);
+    }
+    store_anchor(anchor + (int64_t)bh * HD + d, sum / (float)video_tokens);
+}
+
+template <typename E, typename A>
+__global__ void spark_anchor_kernel(const E* __restrict__ q,
+                                    A* __restrict__ anchor,
+                                    int T, int H, int video_tokens) {
+    const int bh = blockIdx.x, b = bh / H, h = bh % H, d = threadIdx.x;
+    float sum = 0.f;
+    for (int t = 0; t < video_tokens; ++t)
+        sum += to_f32(q[((int64_t)b * T + t) * H * HD + h * HD + d]);
+    store_anchor(anchor + (int64_t)bh * HD + d, sum / (float)video_tokens);
+}
+
+template <typename E, typename A>
+__global__ void spark_summary_kernel(
+    const E* __restrict__ k, const E* __restrict__ v,
+    const A* __restrict__ anchor,
+    __nv_bfloat16* __restrict__ ak, __nv_bfloat16* __restrict__ av,
+    float* __restrict__ lm, int T, int H, int NTB, float scale_log2,
+    const void* __restrict__ permutation, int index64, int video_tokens) {
+    __shared__ float scores[BLK];
+    __shared__ float reduce[HD];
+    __shared__ float smax, sden;
+    const int kb = blockIdx.x, bh = blockIdx.y, b = bh / H, h = bh % H;
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    const int t0 = kb * BLK, len = min(BLK, T - t0);
+    const A* a = anchor + (int64_t)bh * HD;
+
+    for (int i = warp; i < len; i += 4) {
+        float dot = 0.f;
+        const int src_t = source_token(t0 + i, permutation, index64, video_tokens, bh);
+        const E* row = k + ((int64_t)b * T + src_t) * H * HD + h * HD;
+        #pragma unroll
+        for (int d = lane; d < HD; d += 32)
+            dot = fmaf(anchor_to_f32(a[d]), to_f32(row[d]), dot);
+        #pragma unroll
+        for (int off = 16; off; off >>= 1)
+            dot += __shfl_down_sync(0xffffffffu, dot, off);
+        if (lane == 0) scores[i] = dot * scale_log2;
+    }
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        float m = NEG;
+        for (int i = 0; i < len; ++i) m = fmaxf(m, scores[i]);
+        float den = 0.f;
+        // The weight depends only on the block row, not on the output
+        // channel.  Materialize it once here: the old channel loop below
+        // recomputed the same 64 exp2 values independently in all 128
+        // threads (8192 exp2 calls per block).
+        for (int i = 0; i < len; ++i) {
+            const float w = exp2f(scores[i] - m);
+            scores[i] = w;
+            den += w;
+        }
+        smax = m;
+        sden = den;
+    }
+    __syncthreads();
+
+    const int d = threadIdx.x;
+    float sk = 0.f, sv = 0.f;
+    for (int i = 0; i < len; ++i) {
+        const float w = scores[i];
+        const int src_t = source_token(t0 + i, permutation, index64, video_tokens, bh);
+        const int64_t off = ((int64_t)b * T + src_t) * H * HD + h * HD + d;
+        sk = fmaf(w, to_f32(k[off]), sk);
+        sv = fmaf(w, to_f32(v[off]), sv);
+    }
+    sk /= sden;
+    sv /= sden;
+    const int64_t out = ((int64_t)bh * NTB + kb) * HD + d;
+    ak[out] = __float2bfloat16(sk);
+    av[out] = __float2bfloat16(sv);
+    reduce[d] = anchor_to_f32(a[d]) * sk;
+    __syncthreads();
+    for (int width = HD / 2; width; width >>= 1) {
+        if (d < width) reduce[d] += reduce[d + width];
+        __syncthreads();
+    }
+    if (d == 0)
+        lm[(int64_t)bh * NTB + kb] =
+            smax + log2f(sden) - reduce[0] * scale_log2;
+}
+
+template <typename E>
+__global__ void spark_tail_kernel(
+    const E* __restrict__ q, const uint32_t* __restrict__ bits,
+    const __nv_bfloat16* __restrict__ ak,
+    const __nv_bfloat16* __restrict__ av,
+    const float* __restrict__ lm, const float* __restrict__ vsc,
+    __nv_bfloat16* __restrict__ row_o, float* __restrict__ row_m,
+    float* __restrict__ row_l,
+    int T, int H, int NQ, int NTB, float scale_log2) {
+    const int qb = blockIdx.x, bh = blockIdx.y, b = bh / H, h = bh % H;
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int W = (NTB + 31) >> 5;
+    const uint32_t* my_bits = bits + ((int64_t)bh * NQ + qb) * W;
+    const int d0 = lane * 4;
+
+    for (int ri = warp; ri < BLK; ri += 4) {
+        const int t = qb * BLK + ri;
+        if (t >= T) continue;
+        const E* qrow = q + ((int64_t)b * T + t) * H * HD + h * HD;
+        float qv[4], oval[4] = {0.f, 0.f, 0.f, 0.f};
+        #pragma unroll
+        for (int j = 0; j < 4; ++j) qv[j] = to_f32(qrow[d0 + j]);
+        float m = NEG, l = 0.f;
+        for (int kb = 0; kb < NTB; ++kb) {
+            if (!(my_bits[kb >> 5] & (1u << (kb & 31)))) continue;
+            const int64_t base = ((int64_t)bh * NTB + kb) * HD;
+            float dot = 0.f;
+            #pragma unroll
+            for (int j = 0; j < 4; ++j)
+                dot = fmaf(qv[j], __bfloat162float(ak[base + d0 + j]), dot);
+            #pragma unroll
+            for (int off = 16; off; off >>= 1)
+                dot += __shfl_down_sync(0xffffffffu, dot, off);
+            const float score = __shfl_sync(0xffffffffu, dot, 0) * scale_log2 +
+                                lm[(int64_t)bh * NTB + kb];
+            const float mn = fmaxf(m, score);
+            const float alpha = m <= NEG ? 0.f : exp2f(m - mn);
+            const float beta = exp2f(score - mn);
+            #pragma unroll
+            for (int j = 0; j < 4; ++j)
+                oval[j] = oval[j] * alpha + beta * __bfloat162float(av[base + d0 + j]);
+            l = l * alpha + beta;
+            m = mn;
+        }
+        const int64_t out = ((int64_t)b * T + t) * H * HD + h * HD + d0;
+        #pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            const float scaled = l > 0.f ? oval[j] * (255.f / vsc[(int64_t)bh * HD + d0 + j]) : 0.f;
+            row_o[out + j] = __float2bfloat16(scaled);
+        }
+        if (lane == 0) {
+            const int64_t s = ((int64_t)b * T + t) * H + h;
+            row_m[s] = m;
+            row_l[s] = l * 255.f;
+        }
+    }
+}
+
+template <typename E>
+void launch_typed(const void* q, const void* k, const void* v,
+                  const void* bits, const void* vsc,
+                  void* anchor, void* ak, void* av, void* lm,
+                  void* row_o, void* row_m, void* row_l,
+                  int B, int T, int H, int video_tokens, int NQ, int NTB,
+                  float scale_log2, cudaStream_t stream) {
+    spark_anchor_kernel<E, float><<<B * H, HD, 0, stream>>>(
+        (const E*)q, (float*)anchor, T, H, video_tokens);
+    spark_summary_kernel<E, float><<<dim3(NTB, B * H), HD, 0, stream>>>(
+        (const E*)k, (const E*)v, (const float*)anchor,
+        (__nv_bfloat16*)ak, (__nv_bfloat16*)av, (float*)lm,
+        T, H, NTB, scale_log2, nullptr, 0, 0);
+    spark_tail_kernel<E><<<dim3(NQ, B * H), 128, 0, stream>>>(
+        (const E*)q, (const uint32_t*)bits, (const __nv_bfloat16*)ak,
+        (const __nv_bfloat16*)av, (const float*)lm, (const float*)vsc,
+        (__nv_bfloat16*)row_o, (float*)row_m, (float*)row_l,
+        T, H, NQ, NTB, scale_log2);
+}
+
+__global__ void spark_quant_summary_kernel(
+    const __nv_bfloat16* __restrict__ ak,
+    const __nv_bfloat16* __restrict__ av,
+    const float* __restrict__ lm, const float* __restrict__ kmean,
+    const float* __restrict__ vsc,
+    int8_t* __restrict__ rki, float2* __restrict__ rksb,
+    int8_t* __restrict__ rv, int NTB, int RTP) {
+    __shared__ float sred[HD];
+    const int kb = blockIdx.x, bh = blockIdx.y, d = threadIdx.x;
+    const int64_t src = ((int64_t)bh * NTB + kb) * HD + d;
+    const float x = __bfloat162float(ak[src]) - kmean[(int64_t)bh * HD + d];
+    sred[d] = fabsf(x);
+    __syncthreads();
+    for (int width = HD / 2; width; width >>= 1) {
+        if (d < width) sred[d] = fmaxf(sred[d], sred[d + width]);
+        __syncthreads();
+    }
+    const float kscale = fmaxf(sred[0] / 127.f, 1e-8f);
+    const int physical = (kb / BLK) * BLK + perm_key_inv(kb % BLK);
+    rki[((int64_t)bh * RTP + physical) * HD + perm_d(d)] = q8(x, 1.f / kscale);
+    const int vpos = (kb / BLK) * BLK + perm_d(kb % BLK);
+    rv[((int64_t)bh * HD + d) * RTP + vpos] =
+        q8(__bfloat162float(av[src]), 1.f / vsc[(int64_t)bh * HD + d]);
+    if (d == 0)
+        rksb[(int64_t)bh * RTP + physical] =
+            make_float2(kscale, lm[(int64_t)bh * NTB + kb]);
+}
+
+// Direct Spark path: form the weighted block summaries and immediately
+// quantize them into the layout consumed by sol_exact_kernel.  The previous
+// implementation wrote AK/AV/LM to global memory and launched a second CTA
+// per block to read them back for quantization.  Keeping the rounded BF16
+// summaries in registers preserves the old arithmetic while removing that
+// round trip and one full-grid launch.
+template <typename E, typename A>
+__global__ void spark_summary_quant_kernel(
+    const E* __restrict__ k, const E* __restrict__ v,
+    const A* __restrict__ anchor,
+    __nv_bfloat16* __restrict__ ak, __nv_bfloat16* __restrict__ av,
+    float* __restrict__ lm, const float* __restrict__ kmean,
+    const float* __restrict__ vsc,
+    int8_t* __restrict__ rki, float2* __restrict__ rksb,
+    int8_t* __restrict__ rv,
+    int T, int H, int NTB, int RTP, float scale_log2,
+    const void* __restrict__ permutation, int index64, int video_tokens) {
+    __shared__ float scores[BLK];
+    __shared__ float reduce[HD];
+    __shared__ float smax, sden, slm;
+    const int kb = blockIdx.x, bh = blockIdx.y, b = bh / H, h = bh % H;
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    const int t0 = kb * BLK, len = min(BLK, T - t0);
+    const A* a = anchor + (int64_t)bh * HD;
+
+    for (int i = warp; i < len; i += 4) {
+        float dot = 0.f;
+        const int src_t = source_token(t0 + i, permutation, index64, video_tokens, bh);
+        const E* row = k + ((int64_t)b * T + src_t) * H * HD + h * HD;
+        #pragma unroll
+        for (int d = lane; d < HD; d += 32)
+            dot = fmaf(anchor_to_f32(a[d]), to_f32(row[d]), dot);
+        #pragma unroll
+        for (int off = 16; off; off >>= 1)
+            dot += __shfl_down_sync(0xffffffffu, dot, off);
+        if (lane == 0) scores[i] = dot * scale_log2;
+    }
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        float m = NEG;
+        for (int i = 0; i < len; ++i) m = fmaxf(m, scores[i]);
+        float den = 0.f;
+        // Global reweight has one shared anchor, hence one shared softmax
+        // weight per token.  Compute the 64 weights once per block instead
+        // of repeating the same exp2 in every output-channel thread.
+        for (int i = 0; i < len; ++i) {
+            const float w = exp2f(scores[i] - m);
+            scores[i] = w;
+            den += w;
+        }
+        smax = m;
+        sden = den;
+    }
+    __syncthreads();
+
+    const int d = threadIdx.x;
+    float sk = 0.f, sv = 0.f;
+    for (int i = 0; i < len; ++i) {
+        const float w = scores[i];
+        const int src_t = source_token(t0 + i, permutation, index64, video_tokens, bh);
+        const int64_t off = ((int64_t)b * T + src_t) * H * HD + h * HD + d;
+        sk = fmaf(w, to_f32(k[off]), sk);
+        sv = fmaf(w, to_f32(v[off]), sv);
+    }
+    sk /= sden;
+    sv /= sden;
+    const __nv_bfloat16 sk_bf = __float2bfloat16(sk);
+    const __nv_bfloat16 sv_bf = __float2bfloat16(sv);
+    // Preserve the old LM definition: anchor dot the unrounded FP32 weighted
+    // key, while the exact branch consumes the BF16-rounded/INT8 key.
+    reduce[d] = anchor_to_f32(a[d]) * sk;
+    __syncthreads();
+    for (int width = HD / 2; width; width >>= 1) {
+        if (d < width) reduce[d] += reduce[d + width];
+        __syncthreads();
+    }
+    if (d == 0) {
+        slm = smax + log2f(sden) - reduce[0] * scale_log2;
+    }
+    __syncthreads();
+
+    const float x = __bfloat162float(sk_bf) - kmean[(int64_t)bh * HD + d];
+    reduce[d] = fabsf(x);
+    __syncthreads();
+    for (int width = HD / 2; width; width >>= 1) {
+        if (d < width) reduce[d] = fmaxf(reduce[d], reduce[d + width]);
+        __syncthreads();
+    }
+    const float kscale = fmaxf(reduce[0] / 127.f, 1e-8f);
+    const int physical = (kb / BLK) * BLK + perm_key_inv(kb % BLK);
+    rki[((int64_t)bh * RTP + physical) * HD + perm_d(d)] = q8(x, 1.f / kscale);
+    const int vpos = (kb / BLK) * BLK + perm_d(kb % BLK);
+    rv[((int64_t)bh * HD + d) * RTP + vpos] =
+        q8(__bfloat162float(sv_bf), 1.f / vsc[(int64_t)bh * HD + d]);
+    if (d == 0)
+        rksb[(int64_t)bh * RTP + physical] = make_float2(kscale, slm);
+}
+
+}  // namespace
+
+extern "C" void launch_spark_reweight(
+    const void* q, const void* k, const void* v,
+    const void* bits, const void* vsc,
+    void* anchor, void* ak, void* av, void* lm,
+    void* row_o, void* row_m, void* row_l,
+    int B, int T, int H, int video_tokens, int NQ, int NTB,
+    float scale_log2, int elem, cudaStream_t stream) {
+    if (video_tokens <= 0 || video_tokens > T)
+        throw std::runtime_error("spark_reweight: video_tokens must lie in (0, T]");
+    if (elem == SOL_FP16)
+        launch_typed<__half>(q, k, v, bits, vsc, anchor, ak, av, lm,
+                             row_o, row_m, row_l, B, T, H, video_tokens,
+                             NQ, NTB, scale_log2, stream);
+    else
+        launch_typed<__nv_bfloat16>(q, k, v, bits, vsc, anchor, ak, av, lm,
+                                    row_o, row_m, row_l, B, T, H, video_tokens,
+                                    NQ, NTB, scale_log2, stream);
+    const cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess)
+        throw std::runtime_error(std::string("spark_reweight: kernel launch failed: ") +
+                                 cudaGetErrorString(err));
+}
+
+extern "C" void launch_spark_reweight_tokens(
+    const void* qmean, const void* k, const void* v,
+    const void* kmean, const void* vsc,
+    void* anchor, void* ak, void* av, void* lm,
+    void* rki, void* rksb, void* rv,
+    int B, int T, int H, int video_tokens, int NQ, int NTB, int NPAD, int RTP,
+    const void* permutation, int permutation_index64,
+    int anchor_bf16,
+    float scale_log2, int elem, cudaStream_t stream) {
+    if (video_tokens <= 0 || video_tokens > T)
+        throw std::runtime_error("spark_reweight_tokens: video_tokens must lie in (0, T]");
+    if (elem == SOL_FP16 && anchor_bf16) {
+        spark_anchor_from_blocks_kernel<__nv_bfloat16><<<B * H, HD, 0, stream>>>(
+            (const float*)qmean, (__nv_bfloat16*)anchor, video_tokens, NPAD);
+        spark_summary_quant_kernel<__half, __nv_bfloat16><<<dim3(NTB, B * H), HD, 0, stream>>>(
+            (const __half*)k, (const __half*)v, (const __nv_bfloat16*)anchor,
+            (__nv_bfloat16*)ak, (__nv_bfloat16*)av, (float*)lm,
+            (const float*)kmean, (const float*)vsc,
+            (int8_t*)rki, (float2*)rksb, (int8_t*)rv,
+            T, H, NTB, RTP, scale_log2, permutation, permutation_index64, video_tokens);
+    } else if (elem == SOL_FP16) {
+        spark_anchor_from_blocks_kernel<float><<<B * H, HD, 0, stream>>>(
+            (const float*)qmean, (float*)anchor, video_tokens, NPAD);
+        spark_summary_quant_kernel<__half, float><<<dim3(NTB, B * H), HD, 0, stream>>>(
+            (const __half*)k, (const __half*)v, (const float*)anchor,
+            (__nv_bfloat16*)ak, (__nv_bfloat16*)av, (float*)lm,
+            (const float*)kmean, (const float*)vsc,
+            (int8_t*)rki, (float2*)rksb, (int8_t*)rv,
+            T, H, NTB, RTP, scale_log2, permutation, permutation_index64, video_tokens);
+    } else if (anchor_bf16) {
+        spark_anchor_from_blocks_kernel<__nv_bfloat16><<<B * H, HD, 0, stream>>>(
+            (const float*)qmean, (__nv_bfloat16*)anchor, video_tokens, NPAD);
+        spark_summary_quant_kernel<__nv_bfloat16, __nv_bfloat16><<<dim3(NTB, B * H), HD, 0, stream>>>(
+            (const __nv_bfloat16*)k, (const __nv_bfloat16*)v,
+            (const __nv_bfloat16*)anchor,
+            (__nv_bfloat16*)ak, (__nv_bfloat16*)av, (float*)lm,
+            (const float*)kmean, (const float*)vsc,
+            (int8_t*)rki, (float2*)rksb, (int8_t*)rv,
+            T, H, NTB, RTP, scale_log2, permutation, permutation_index64, video_tokens);
+    } else {
+        spark_anchor_from_blocks_kernel<float><<<B * H, HD, 0, stream>>>(
+            (const float*)qmean, (float*)anchor, video_tokens, NPAD);
+        spark_summary_quant_kernel<__nv_bfloat16, float><<<dim3(NTB, B * H), HD, 0, stream>>>(
+            (const __nv_bfloat16*)k, (const __nv_bfloat16*)v, (const float*)anchor,
+            (__nv_bfloat16*)ak, (__nv_bfloat16*)av, (float*)lm,
+            (const float*)kmean, (const float*)vsc,
+            (int8_t*)rki, (float2*)rksb, (int8_t*)rv,
+            T, H, NTB, RTP, scale_log2, permutation, permutation_index64, video_tokens);
+    }
+    const cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess)
+        throw std::runtime_error(std::string("spark_reweight_tokens: kernel launch failed: ") +
+                                 cudaGetErrorString(err));
+}
diff --git a/comfy_kitchen/backends/eager/sol_attn.py b/comfy_kitchen/backends/eager/sol_attn.py
index 6f47098..9831ad4 100644
--- a/comfy_kitchen/backends/eager/sol_attn.py
+++ b/comfy_kitchen/backends/eager/sol_attn.py
@@ -132,6 +132,7 @@ def sol_attn(
     coarse_gate: torch.Tensor | None = None,
     token_aug: int = 0,   # ignored: the reference is exact arithmetic over the same
                           # block selection, so there is no token routing stage to model
+    tail_granularity: str = "block",
 ) -> torch.Tensor:
     """Sol-Attn over ``(B, T, H, D)`` tensors. See the module docstring.
 
@@ -143,6 +144,10 @@ def sol_attn(
     output rows are unspecified), and ``coarse_gate`` adds VSA's gated coarse
     branch: ``gate * softmax(q_mean k_mean^T * scale) v_mean`` per block.
     """
