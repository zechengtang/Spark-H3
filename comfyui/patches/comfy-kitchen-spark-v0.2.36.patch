+def spark_reblock_bthd(
+    input: torch.Tensor,
+    permutation: torch.Tensor,
+    video_tokens: int,
+) -> torch.Tensor:
+    """Apply a head-wise destination-to-source token permutation to BTHD data.
+
+    Only ``[0, video_tokens)`` is gathered; packed conditioning rows keep their
+    original order.  Supplying the inverse permutation restores the output.
+    """
+    if _C is None:
+        raise RuntimeError("spark_reblock_bthd requires the compiled CUDA backend")
+    if input.ndim != 4 or input.dtype not in (torch.bfloat16, torch.float16):
+        raise ValueError("spark_reblock_bthd: input must be BTHD bfloat16/float16")
+    batch, tokens, heads, _ = input.shape
+    if not 0 <= video_tokens <= tokens:
+        raise ValueError("spark_reblock_bthd: video_tokens must lie in [0, T]")
+    if permutation.shape != (batch, heads, video_tokens):
+        raise ValueError(
+            "spark_reblock_bthd: permutation must have shape "
+            f"{(batch, heads, video_tokens)}, got {tuple(permutation.shape)}"
+        )
+    if permutation.device != input.device or permutation.dtype not in (torch.int32, torch.int64):
+        raise ValueError("spark_reblock_bthd: permutation must be int32/int64 on input.device")
+    input = input.contiguous()
+    permutation = permutation.contiguous()
+    output = torch.empty_like(input)
+    _C.spark_reblock_bthd(
+        _wrap_for_dlpack(input), _wrap_for_dlpack(permutation), _wrap_for_dlpack(output),
+        int(video_tokens), torch.cuda.current_stream(input.device).cuda_stream,
+    )
+    return output
+
+
+def spark_attn(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    *,
+    video_tokens: int,
+    anchor_dtype: torch.dtype = torch.float32,
+    topk_ratio: float = 0.1,
+    tau: float = 1.0,
