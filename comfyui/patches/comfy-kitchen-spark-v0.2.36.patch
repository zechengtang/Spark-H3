+// Reweight summary construction depends on preprocess' qmean/kmean/vscale,
+// but is independent of V transpose and route selection.  A per-host-thread
+// nonblocking stream lets those two branches overlap without exposing stream
+// management through the Python API.  The main stream waits before exact
+// attention consumes the quantized virtual K/V buffers.
+struct SparkAuxStream {
+    int device = -1;
+    cudaStream_t stream = nullptr;
+    cudaEvent_t preprocess_done = nullptr;
+    cudaEvent_t summary_done = nullptr;
+
+    void ensure() {
+        int current = -1;
+        cudaGetDevice(&current);
+        if (stream && current == device) return;
+        if (stream) {
+            cudaEventDestroy(preprocess_done);
+            cudaEventDestroy(summary_done);
+            cudaStreamDestroy(stream);
+        }
+        device = current;
+        if (cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking) != cudaSuccess ||
+            cudaEventCreateWithFlags(&preprocess_done, cudaEventDisableTiming) != cudaSuccess ||
+            cudaEventCreateWithFlags(&summary_done, cudaEventDisableTiming) != cudaSuccess)
+            throw std::runtime_error("spark_attn: failed to create auxiliary CUDA stream");
+    }
+
+    ~SparkAuxStream() {
+        if (!stream) return;
+        cudaEventDestroy(preprocess_done);
+        cudaEventDestroy(summary_done);
+        cudaStreamDestroy(stream);
+    }
+};
