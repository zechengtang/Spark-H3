+    effective_tau = -1e9 if all_exact else tau
+    _check_sol_args(q.device, sink_blocks, sink_q, effective_topk, q=q, k=k, v=v)
+    if q.dtype not in (torch.bfloat16, torch.float16) or q.shape[-1] != _SOL_HD:
+        raise ValueError("spark_attn requires BF16/FP16 BTHD tensors with head_dim=128")
+    if not 0 < video_tokens <= q.shape[1]:
+        raise ValueError("spark_attn: video_tokens must lie in (0, T]")
+    has_reblock = query_permutation is not None or key_permutation is not None
+    if force_local_blocks is None:
+        force_local_blocks = not has_reblock
+    elif type(force_local_blocks) is not bool:
+        raise TypeError("spark_attn: force_local_blocks must be bool or None")
+    if has_reblock:
+        if query_permutation is None or key_permutation is None:
+            raise ValueError("spark_attn: query_permutation and key_permutation are required together")
+        expected = (q.shape[0], q.shape[2], video_tokens)
+        permutations = [("query", query_permutation), ("key", key_permutation)]
+        if query_inverse is not None:
+            permutations.append(("query_inverse", query_inverse))
+        for name, permutation in permutations:
+            if permutation.shape != expected or permutation.device != q.device:
+                raise ValueError(f"spark_attn: {name} permutation must have shape {expected} on q.device")
+            if permutation.dtype not in (torch.int32, torch.int64):
+                raise ValueError(f"spark_attn: {name} permutation must be int32/int64")
+        if query_permutation.dtype != key_permutation.dtype:
+            key_permutation = key_permutation.to(query_permutation.dtype)
+        query_permutation = query_permutation.contiguous()
+        key_permutation = key_permutation.contiguous()
