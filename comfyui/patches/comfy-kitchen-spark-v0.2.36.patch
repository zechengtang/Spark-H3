+    rksb = torch.empty((batch, heads, rtp, 2), dtype=torch.float32, device=q.device)
+    rv = torch.empty_like(rki)
+    out = torch.empty_like(q)
+    _C.spark_attn(
+        _wrap_for_dlpack(q), _wrap_for_dlpack(k), _wrap_for_dlpack(v),
