[project]
name = "comfyui-spark-h3"
version = "@VERSION@"
description = "Spark-H3 accelerates ComfyUI's native MiniMax-H3 video generation with adaptive block-sparse attention by grouping similar tokens and correcting tail tokens through reweighting. v0.1.3 Linux benchmarks (LightX2V 768p 8-step, 1344x768, 345 frames, 24 FPS; topk_ratio 20%, warmup_steps 2, dense SDPA): RTX 3090 - Fidelity 2.42x / Speed 4.62x; RTX 4090 - 2.37x / 4.35x; RTX PRO 6000 Blackwell - 2.05x / 3.15x."
requires-python = ">=3.10"
license = {file = "LICENSE"}
dynamic = ["dependencies"]
classifiers = [
    "Operating System :: OS Independent",
    "Programming Language :: Python :: 3",
    "License :: OSI Approved :: Apache Software License",
]

[project.urls]
Repository = "https://github.com/zechengtang/Spark-H3"
Documentation = "https://github.com/zechengtang/Spark-H3/blob/main/comfyui/README.md"

[tool.setuptools.dynamic]
dependencies = {file = ["requirements.txt"]}

[tool.comfy]
PublisherId = "@PUBLISHER_ID@"
DisplayName = "ComfyUI Spark-H3"
requires-comfyui = ">=0.38.0,<0.43.0"
